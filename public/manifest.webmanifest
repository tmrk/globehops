{
  "name": "GlobeHops",
  "short_name": "GlobeHops",
  "description": "See your journey by air as great-circle routes on an interactive 3D globe.",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "background_color": "#04060c",
  "theme_color": "#05080f",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "id": "./",
  "lang": "en",
  "dir": "ltr",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "any",
  "categories": ["travel", "navigation", "education"],
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "screenshots": [
    {
      "src": "screenshots/wide.webp",
      "sizes": "1440x900",
      "type": "image/webp",
      "form_factor": "wide",
      "label": "Explore a journey on the globe"
    },
    {
      "src": "screenshots/narrow.webp",
      "sizes": "1082x2202",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "Plan a journey on your phone"
    }
  ]
}
