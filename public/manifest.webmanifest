{
  "name": "GlobeHops",
  "short_name": "GlobeHops",
  "description": "See your journey by air as great-circle routes on an interactive 3D globe.",
  "start_url": "./",
  "scope": "./",
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": { "title": "share-title", "text": "share-text", "url": "share-url" }
  },
  "display": "fullscreen",
  "background_color": "#04060c",
  "theme_color": "#05080f",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "id": "./",
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/gpx+xml": [".gpx"],
        "application/vnd.google-earth.kml+xml": [".kml"],
        "application/vnd.google-earth.kmz": [".kmz"],
        "application/geo+json": [".geojson"],
        "text/csv": [".csv"],
        "text/plain": [".igc"],
        "application/xml": [".fpl", ".pln", ".lnmpln"]
      },
      "launch_type": "single-client"
    }
  ],
  "lang": "en",
  "dir": "ltr",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "any",
  "categories": ["travel", "navigation", "education"],
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "screenshots": [
    {
      "src": "screenshots/wide.webp",
      "sizes": "1440x900",
      "type": "image/webp",
      "form_factor": "wide",
      "label": "Explore a journey on the globe"
    },
    {
      "src": "screenshots/narrow.webp",
      "sizes": "1082x2202",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "Plan a journey on your phone"
    }
  ]
}
